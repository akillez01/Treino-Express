ENVIRONMENT=dev
# Runtime da API: role restrita, sujeita a RLS (ver migration 0001).
DATABASE_URL=postgresql+asyncpg://treino_app:treino_app@localhost:5434/treino_express
# Só para `alembic upgrade` — superusuário do docker-compose do handoff.
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://treino:treino@localhost:5434/treino_express
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=changeme-generate-a-real-secret
CORS_ORIGINS=["http://localhost:3000"]
