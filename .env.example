ENVIRONMENT=dev
# Runtime da API: role restrita, sujeita a RLS (ver migration 0001).
DATABASE_URL=postgresql+asyncpg://treino_app:treino_app@localhost:5434/treino_express
# Só para `alembic upgrade` — superusuário do docker-compose do handoff.
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://treino:treino@localhost:5434/treino_express
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=changeme-generate-a-real-secret
CORS_ORIGINS=["http://localhost:3000"]

# Login demo — NUNCA true em produção
ENABLE_DEMO_LOGIN=false

# Google Identity Services (login da conta Treino Express; não autentica Spotify)
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_HOSTED_DOMAIN=
GOOGLE_LOGIN_ENABLED=false
# Necessário no MVP enquanto o RLS não permite busca global sem tenant.
GOOGLE_DEFAULT_ACADEMIA_ID=

# Spotify (developer.spotify.com/dashboard > seu app > Settings)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=BR
# Deve ser cadastrada exatamente no Spotify Dashboard (OAuth redirect URI).
SPOTIFY_REDIRECT_URI=http://localhost:3000/aluno/spotify/callback
SPOTIFY_SCOPES=streaming user-read-email user-read-private

# Endereços públicos (vão dentro dos QR Codes da TV)
PUBLIC_API_URL=http://127.0.0.1:8000
PUBLIC_WEB_URL=http://127.0.0.1:3000

# WhatsApp Business Cloud API (deixe vazio para só simular os lembretes)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=lembrete_sequencia
